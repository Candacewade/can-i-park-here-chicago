# Copy to .env for local development. Every value has a working default;
# nothing here is required to run the vertical slice.

# --- Runtime AI agent (Claude Agent SDK) ---
# The SDK authenticates through the local Claude Code CLI (your Claude subscription).
# We do NOT use ANTHROPIC_API_KEY. Set this only if `claude` is not on your PATH
# and not found as a bundled editor-extension binary.
# CLAUDE_CODE_CLI_PATH=/absolute/path/to/claude
# AGENT_MODEL=claude-sonnet-4-5

# --- City of Chicago Open Data (Socrata) ---
# Optional app token: raises rate limits. Free to register; not required.
# SOCRATA_APP_TOKEN=
# SOCRATA_TIMEOUT_SECONDS=10

# --- HTTP API ---
# FRONTEND_ORIGINS=https://your-app.vercel.app
# Absolute URLs used ONLY for the management links inside monitoring emails:
#   API_BASE_URL -- this backend (the one-click unsubscribe endpoint lives here)
#   APP_BASE_URL -- the React app (the "change parking spot" deep link)
# Unset -> APP_BASE_URL falls back to the first non-localhost FRONTEND_ORIGINS
# entry; the links still render but are not click-through from an email client.
# API_BASE_URL=https://your-service.onrender.com
# APP_BASE_URL=https://your-app.vercel.app

# --- Runtime user data (monitoring + resolved addresses) ---
# All user data (watches.json, blocks.json, notify_map.json) goes to a SEPARATE
# PRIVATE GitHub repo via the Contents API. Never the public code repo.
# Without these, everything falls back to a git-ignored backend/.data/ dir.
# GH_DATA_REPO=you/can-i-park-here-chicago-data
# GH_DATA_TOKEN=github_pat_...      fine-grained, Contents:rw on that repo only

# Email: with no Gmail credentials, messages are written to backend/outbox/.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional seed/override for the notify map:
# WATCH_NOTIFY_MAP={"wch_abc123": {"email": "you@example.com"}}
# Protect POST /api/monitor/run for an external scheduler:
# MONITOR_TOKEN=
# Run the agent in scheduled workflows / on Render: a subscription OAuth token
# from `claude setup-token` (NOT an API key). Absent -> deterministic templates.
# CLAUDE_CODE_OAUTH_TOKEN=
