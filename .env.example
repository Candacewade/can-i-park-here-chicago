# Copy to .env for local development. Every value has a working default;
# nothing here is required to run the vertical slice.

# --- Runtime AI agent (Claude Agent SDK) ---
# The SDK authenticates through the local Claude Code CLI (your Claude subscription).
# We do NOT use ANTHROPIC_API_KEY. Set this only if `claude` is not on your PATH
# and not found as a bundled editor-extension binary.
# CLAUDE_CODE_CLI_PATH=/absolute/path/to/claude
# AGENT_MODEL=claude-sonnet-4-5

# --- City of Chicago Open Data (Socrata) ---
# Optional app token: raises rate limits. Free to register; not required.
# SOCRATA_APP_TOKEN=
# SOCRATA_TIMEOUT_SECONDS=10
