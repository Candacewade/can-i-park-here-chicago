# Copy to .env for local development. Every value has a working default;
# nothing here is required to run the vertical slice.

# --- Runtime AI agent (Claude Agent SDK) ---
# The SDK authenticates through the local Claude Code CLI (your Claude subscription).
# We do NOT use ANTHROPIC_API_KEY. Set this only if `claude` is not on your PATH
# and not found as a bundled editor-extension binary.
# CLAUDE_CODE_CLI_PATH=/absolute/path/to/claude
# AGENT_MODEL=claude-sonnet-4-5

# --- City of Chicago Open Data (Socrata) ---
# Optional app token: raises rate limits. Free to register; not required.
# SOCRATA_APP_TOKEN=
# SOCRATA_TIMEOUT_SECONDS=10

# --- HTTP API ---
# FRONTEND_ORIGINS=https://your-app.vercel.app

# --- Proactive monitoring (Slice 4) ---
# Email: with no Gmail credentials, messages are written to backend/outbox/.
# GMAIL_SENDER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Notification map (the PII). Prod: this env / a GH Actions secret. Dev: the API
# also writes backend/notify_map.local.json (git-ignored).
# WATCH_NOTIFY_MAP={"wch_abc123": {"email": "you@example.com"}}
# Protect POST /api/monitor/run for an external scheduler:
# MONITOR_TOKEN=
# Run the agent in scheduled workflows / on Render: a subscription OAuth token
# from `claude setup-token` (NOT an API key). Absent -> deterministic templates.
# CLAUDE_CODE_OAUTH_TOKEN=
# Let the Render API write watches.json via the GitHub contents API:
# GH_WATCHES_REPO=Candacewade/can-i-park-here-chicago
# GH_WATCHES_TOKEN=github_pat_...
